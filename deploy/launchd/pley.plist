<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for pley on macOS (runs at login as the current user, so it can
  read media in your home folder and on mounted volumes). deploy/README.md:
    brew install ffmpeg-full
    sudo mkdir -p /usr/local/bin && sudo cp pley pley-transcoder /usr/local/bin/
    cp pley.plist ~/Library/LaunchAgents/pley.server.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pley.server.plist
  Stop with: launchctl bootout gui/$(id -u)/pley.server
  Data and logs live in ~/Library/Application Support/pley.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>pley.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/pley</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Homebrew's programs (Apple silicon and Intel locations); pley
             finds Homebrew's ffmpeg-full by itself. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ExitTimeOut</key>
    <integer>45</integer>
    <!-- No StandardOutPath: pley writes its own log, readable only by you, to
         ~/Library/Application Support/pley/logs/pley.log (a file in /tmp could
         be read, or created beforehand, by other users). -->
</dict>
</plist>
