{
  "name": "pley-tv",
  "private": true,
  "version": "0.1.0",
  "description": "What pley's Samsung (Tizen) and LG (webOS) TV apps share: the screens, sign-in, capabilities, playback sessions and subtitles. Each app adds its platform's player and probes.",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./build": "./build/build-app.mjs",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "lucide": "^1.61.0",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "~5.9",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.2"
  }
}
