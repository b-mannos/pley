{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The server picker, bundled with the app. Pages from servers get none of this.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-saved-servers",
    "allow-save-server",
    "allow-forget-server",
    "allow-check-server",
    "allow-discover",
    "allow-open-server",
    "allow-downloads",
    "allow-play-download",
    "allow-show-download",
    "allow-remove-download",
    "allow-retry-download"
  ]
}
