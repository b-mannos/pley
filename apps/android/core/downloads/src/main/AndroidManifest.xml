<?xml version="1.0" encoding="utf-8"?>
<!--
  Downloads run in a foreground service of type dataSync while there is
  one to fetch, with a notification that shows how far they are; it is
  started by the app only (not exported).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="app.pley.android.downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
