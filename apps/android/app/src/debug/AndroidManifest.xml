<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: the native app's own launchers, beside the web view
  app's ("pley"), so it can be tried while it is built. Release builds keep
  ServersActivity as their only launcher until the native app replaces it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- As in the main manifest; repeated so lint sees them beside the TV launcher. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application>
        <!-- Phones and tablets. -->
        <activity-alias
            android:name=".NativeLauncher"
            android:exported="true"
            android:label="@string/launcher_native"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Android TV, Google TV and Fire TV home screens, with the TV banner. -->
        <activity-alias
            android:name=".TvLauncher"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:label="@string/launcher_tv"
            android:targetActivity=".TvActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
