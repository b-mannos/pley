{
  "name": "pley-tizen",
  "private": true,
  "version": "0.0.1",
  "description": "Pley for Samsung TVs: a Tizen web app that plays through Samsung's own player (AVPlay).",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "package": "bun scripts/build.mjs && bun scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "pley-tv": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
