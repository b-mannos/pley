<?xml version="1.0" encoding="utf-8"?>
<!-- A category in Live TV's rail (a MarkupList; Live.brs's liveRail): its
     name and how many channels, a region with its groups under it (open
     or not), a group of a region set in under it, the category shown in
     the accent. -->
<component name="LiveRailItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onLayout" />
        <field id="height" type="float" onChange="onLayout" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/LiveRailItem.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Poster id="back" uri="pkg:/images/pill.9.png" blendColor="0x38BDF8FF" opacity="0" />
        <Poster id="icon" width="32" height="32" loadWidth="32" loadHeight="32" visible="false" />
        <Poster id="mark" width="28" height="28" loadWidth="28" loadHeight="28" blendColor="0x8B95A5FF" visible="false" />
        <Label id="title" vertAlign="center" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
        </Label>
        <Label id="count" horizAlign="right" vertAlign="center" color="0x8B95A5FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="24" />
        </Label>
    </children>
</component>
