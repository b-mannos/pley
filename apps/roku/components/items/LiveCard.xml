<?xml version="1.0" encoding="utf-8"?>
<!-- A Live TV channel in a grid of cards (Live.brs's liveCard): its logo
     (or its name) with its number and a star for a favourite, the name,
     what's on with how far along it is, and what's next. -->
<component name="LiveCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onLayout" />
        <field id="height" type="float" onChange="onLayout" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="rowHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/LiveCard.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Poster id="frame" uri="pkg:/images/tile.9.png" blendColor="0x262B35FF" />
        <Poster id="plate" uri="pkg:/images/tile.9.png" blendColor="0x2E3440FF" />
        <Label id="fallback" color="0xA1A9B6FF" horizAlign="center" vertAlign="center" wrap="true" maxLines="2">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="32" />
        </Label>
        <Poster id="logo" loadDisplayMode="scaleToFit" />
        <Rectangle id="numberBack" color="0x16191ECC" height="40" visible="false" />
        <Label id="number" height="40" horizAlign="center" vertAlign="center" color="0xEBEBEBFF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
        </Label>
        <Poster id="star" uri="pkg:/images/icons/star-fill.png" width="40" height="40" blendColor="0x38BDF8FF" visible="false" />
        <Label id="title" color="0xEBEBEBFF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
        </Label>
        <Label id="line" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
        </Label>
        <Rectangle id="track" color="0x2E3440FF" height="6" />
        <Rectangle id="fill" color="0x38BDF8FF" height="6" />
        <Label id="nextLine" color="0x8B95A5FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="24" />
        </Label>
    </children>
</component>
