<?xml version="1.0" encoding="utf-8"?>
<!-- Skip Intro / Skip Credits over the video, with the focus while shown:
     OK presses it; play, fast forward and rewind go to the player, which
     acts on the video; Back and the rest go on as without the button. -->
<component name="SkipButton" extends="Group">
    <interface>
        <field id="text" type="string" onChange="onText" />
        <field id="pressed" type="boolean" alwaysNotify="true" />
        <!-- "play", "fastforward", "rewind" or "replay", as pressed -->
        <field id="playKey" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/SkipButton.brs" />
    <children>
        <Rectangle width="360" height="84" color="0x38BDF8FF" />
        <Label id="label" width="360" height="84" horizAlign="center" vertAlign="center" color="0x16191EFF" font="font:MediumBoldSystemFont" />
    </children>
</component>
