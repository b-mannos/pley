<?xml version="1.0" encoding="utf-8"?>
<!-- A server in the server list: its name, under it its address (or
     "Connecting to …", or "Can't reach it" for a saved one that doesn't
     answer), and where it came from (on this network) or a warning. -->
<component name="ServerRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/ServerRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Rectangle id="background" width="1000" height="104" color="0x262B35FF" />
        <Label id="name" translation="[32, 14]" width="620" color="0xEBEBEBFF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="36" />
        </Label>
        <Label id="address" translation="[32, 60]" width="620" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
        </Label>
        <Label id="tag" translation="[640, 36]" width="328" horizAlign="right" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
        </Label>
    </children>
</component>
