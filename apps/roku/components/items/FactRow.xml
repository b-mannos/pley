<?xml version="1.0" encoding="utf-8"?>
<!-- A line of Diagnostics, as Android TV's: a fact's label in a column of
     its own and its value beside it, or a section's heading ("This TV",
     "What it plays"), which the focus passes over. -->
<component name="FactRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/FactRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <children>
        <Poster id="focus" width="1728" height="52" uri="pkg:/images/button-focus.9.png" visible="false" />
        <Label id="label" translation="[24, 0]" width="340" height="52" vertAlign="center" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
        </Label>
        <Label id="value" translation="[388, 0]" width="1316" height="52" vertAlign="center" color="0xEBEBEBFF">
            <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
        </Label>
        <Label id="heading" translation="[0, 0]" width="1728" height="52" vertAlign="bottom" color="0xEBEBEBFF" visible="false">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="36" />
        </Label>
    </children>
</component>
