<?xml version="1.0" encoding="utf-8"?>
<!-- A movie or an episode: its backdrop and poster, what it is, and Resume /
     Play from start. The text is laid out top to bottom, leaving out what a
     title doesn't have. -->
<component name="DetailsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" opacity="0.4" />
        <Rectangle id="shade" width="1260" height="1080" color="0x16191ED9" />
        <Poster id="poster" translation="[1404, 120]" width="420" height="630" loadWidth="420" loadHeight="630" loadDisplayMode="scaleToZoom" />
        <LayoutGroup id="column" translation="[96, 120]" layoutDirection="vert" itemSpacings="[48]">
            <!-- Only the labels with text stay in it (layoutText). -->
            <LayoutGroup id="text" layoutDirection="vert">
                <Label id="heading" width="1100" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
                <Label id="line" width="1100" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                <Label id="genres" width="1100" color="0x8B95A5FF" font="font:SmallestSystemFont" />
                <Label id="tagline" width="1100" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:SmallerBoldSystemFont" />
                <Label id="summary" width="1080" wrap="true" maxLines="7" lineSpacing="6" color="0xEBEBEBFF" font="font:SmallerSystemFont" />
            </LayoutGroup>
            <Group id="actions">
                <ButtonGroup id="buttons" iconUri="" focusedIconUri="" minWidth="560" visible="false" />
                <Label id="note" width="1100" wrap="true" color="0xA1A9B6FF" visible="false" font="font:SmallSystemFont" />
            </Group>
        </LayoutGroup>
        <Label id="message" translation="[96, 480]" width="1100" wrap="true" color="0xA1A9B6FF" text="Loading…" font="font:MediumSystemFont" />
    </children>
</component>
