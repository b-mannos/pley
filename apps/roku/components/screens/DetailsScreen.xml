<?xml version="1.0" encoding="utf-8"?>
<!-- A movie or an episode: its backdrop, what it is, and Resume / Play from
     start. -->
<component name="DetailsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" opacity="0.4" />
        <Rectangle id="shade" width="1260" height="1080" color="0x16191ED9" />
        <Label id="heading" translation="[96, 120]" width="1100" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <Label id="line" translation="[96, 300]" width="1100" color="0xA1A9B6FF" font="font:SmallSystemFont" />
        <Label id="genres" translation="[96, 350]" width="1100" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="tagline" translation="[96, 410]" width="1100" color="0xEBEBEBFF" font="font:SmallerBoldSystemFont" />
        <Label id="summary" translation="[96, 466]" width="1080" wrap="true" maxLines="7" lineSpacing="6" color="0xEBEBEBFF" font="font:SmallerSystemFont" />
        <ButtonGroup id="buttons" iconUri="" focusedIconUri="" translation="[96, 800]" minWidth="560" visible="false" />
        <Label id="note" translation="[96, 820]" width="1100" wrap="true" color="0xA1A9B6FF" visible="false" font="font:SmallSystemFont" />
        <Label id="message" translation="[96, 480]" width="1100" wrap="true" color="0xA1A9B6FF" text="Loading…" font="font:MediumSystemFont" />
    </children>
</component>
