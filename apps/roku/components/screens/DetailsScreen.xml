<?xml version="1.0" encoding="utf-8"?>
<!-- A movie, an episode, a show or a season, as Android TV's title page:
     its backdrop and poster, what it is, and its buttons (Resume and From
     start, or Play; a show's or a season's next episode, Request more
     seasons; Mark as watched, Audio and subtitles, My List, Trailer, Add
     to playlist, More…). Audio and subtitles and More open a panel over
     the right of the page: the version and tracks to play; the rating, Go
     to show and season, Media info, Details (the whole summary and the
     title's facts). The text is laid out top to bottom, leaving out what a
     title doesn't have. Under it, a show's or a season's tabs (more than
     one season) and the season's episodes, then rows of extras, cast and
     crew, More Like This and the collections it is part of: their top
     shows under the buttons. Once the focus is down there, an info block
     at the top says what the title is, or the episode in focus, and the
     part with the focus comes up under it. Under the poster, how a request
     for the title stands. -->
<component name="DetailsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- Another device changed titles (MainScene's titleChanges). -->
        <field id="refresh" type="boolean" alwaysNotify="true" />
        <!-- The scene's: what requests let the profile do. -->
        <field id="requestSummary" type="assocarray" />
        <!-- Set by the scene: requests changed (the title's is asked
             again). -->
        <field id="requestsChanged" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Details.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Media.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" />
        <!-- Android TV's two gradients over the backdrop (stretched pictures):
             the page's colour from the left, and from below, which comes up
             over the backdrop as the page slides up. -->
        <Poster uri="pkg:/images/scrim-left.png" width="1600" height="1080" blendColor="0x16191EFF" />
        <Group id="shade" translation="[0, 520]">
            <Poster uri="pkg:/images/scrim-bottom.png" width="1920" height="480" blendColor="0x16191EFF" />
            <Rectangle translation="[0, 479]" width="1920" height="1080" color="0x16191EFF" />
        </Group>
        <!-- What the title is and its buttons, while they have the focus. -->
        <Group id="page" visible="false">
            <MaskGroup translation="[1404, 120]" maskUri="pkg:/images/poster-mask.png" maskSize="[420, 630]">
                <Poster id="poster" width="420" height="630" loadWidth="420" loadHeight="630" loadDisplayMode="scaleToZoom" />
            </MaskGroup>
            <!-- The title's request, where there is one (GET
                 /api/items/{id}/request). -->
            <StagePill id="stage" translation="[1404, 774]" stacked="true" maxWidth="420" visible="false" />
            <Label id="stageLine" translation="[1404, 852]" width="420" wrap="true" maxLines="3" color="0xA1A9B6FF" visible="false">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
            <LayoutGroup id="column" translation="[96, 96]" layoutDirection="vert" itemSpacings="[44]">
                <!-- Only the labels with text stay in it (layoutText). -->
                <LayoutGroup id="text" layoutDirection="vert">
                    <Label id="heading" width="1100" wrap="true" maxLines="2" color="0xEBEBEBFF">
                        <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="56" />
                    </Label>
                    <!-- An episode's "S1 · E3 · Pilot", a season's title, under
                         the show's name, as Home's hero says it. -->
                    <Label id="context" width="1100" maxLines="1" color="0xEBEBEBFF">
                        <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="32" />
                    </Label>
                    <Label id="line" width="1100" color="0xA1A9B6FF">
                        <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
                    </Label>
                    <!-- "1 h 33 min left" for a title resumed. -->
                    <Label id="left" width="1100" maxLines="1" color="0x38BDF8FF">
                        <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="30" />
                    </Label>
                    <Label id="genres" width="1100" color="0x8B95A5FF">
                        <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
                    </Label>
                    <!-- "Directed by … · Starring …". -->
                    <Label id="credits" width="1100" maxLines="1" color="0xA1A9B6FF">
                        <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
                    </Label>
                    <Label id="tagline" width="1100" maxLines="1" color="0xEBEBEBFF">
                        <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="30" />
                    </Label>
                    <Label id="summary" width="1080" wrap="true" maxLines="4" lineSpacing="6" color="0xEBEBEBFF">
                        <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="30" />
                    </Label>
                    <Label id="note" width="1100" wrap="true" color="0xA1A9B6FF">
                        <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
                    </Label>
                </LayoutGroup>
                <Buttons id="buttons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="560" visible="false" />
            </LayoutGroup>
        </Group>
        <!-- Under the buttons, their top in view at y = 940: the season
             tabs, the season's episodes, then the rows. Placed by
             placeLower. -->
        <Group id="lower" translation="[0, 940]">
            <!-- The tabs, cut off at the safe area's right edge, slide to
                 keep the one in focus in view (scrollTabs). -->
            <Group id="tabStrip" translation="[96, 0]" clippingRect="[0, -8, 1728, 72]">
                <ChipRow id="tabs" visible="false" />
            </Group>
            <RowList id="episodes" translation="[80, 0]" itemComponentName="Tile" itemSize="[1744, 396]" numRows="1" rowItemSize="[[441, 320]]" rowItemSpacing="[[0, 0]]" showRowLabel="[true]" rowLabelOffset="[[16, 8]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" visible="false">
                <Font role="rowLabelFont" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </RowList>
            <!-- A season without episodes says so in the row's place. -->
            <Label id="episodesNote" translation="[96, 0]" width="1100" color="0xA1A9B6FF" visible="false">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </Label>
            <RowList id="rows" translation="[80, 0]" itemComponentName="Tile" itemSize="[1744, 506]" numRows="2" itemSpacing="[0, 28]" rowItemSpacing="[[0, 0]]" showRowLabel="[true]" rowLabelOffset="[[16, 8]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" visible="false">
                <Font role="rowLabelFont" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </RowList>
        </Group>
        <!-- With the focus under the buttons: the title and its line, then
             the episode in focus (its title, line and summary) or the
             title's summary, as Home's info block. -->
        <LayoutGroup id="infoBlock" translation="[96, 56]" layoutDirection="vert" visible="false">
            <Label id="infoTitle" width="1300" maxLines="1" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <Label id="infoMeta" width="1300" maxLines="1" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </Label>
            <Label id="infoEpisode" width="1300" maxLines="1" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="32" />
            </Label>
            <Label id="infoEpisodeLine" width="1300" maxLines="1" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
            <Label id="infoSummary" width="1100" wrap="true" maxLines="2" lineSpacing="6" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="30" />
            </Label>
        </LayoutGroup>
        <!-- Loading, and a load that failed: why, with Retry (Back for a
             title gone). -->
        <LayoutGroup id="message" translation="[96, 400]" layoutDirection="vert" itemSpacings="[16, 36]">
            <Label id="messageTitle" width="1100" wrap="true" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <Label id="messageText" width="1100" wrap="true" color="0xA1A9B6FF" text="Loading…">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="34" />
            </Label>
            <Buttons id="messageButton" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="320" visible="false" />
        </LayoutGroup>
        <!-- A menu (Audio and subtitles, More), or the choices of one of its
             entries. It leaves the buttons in view, and is wider than
             Settings' for a version's long line. -->
        <Group id="panel" visible="false">
            <Rectangle translation="[720, 0]" width="1200" height="1080" color="0x1E222AFF" />
            <Label id="panelTitle" translation="[776, 56]" width="1088" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <LabelList id="menu" translation="[776, 150]" itemSize="[1088, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="34" />
                <Font role="focusedFont" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </LabelList>
            <RadioButtonList id="choices" translation="[776, 150]" itemSize="[1088, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" visible="false">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="34" />
                <Font role="focusedFont" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </RadioButtonList>
            <!-- Media info: Up and Down scroll it. -->
            <ScrollableText id="info" translation="[776, 150]" width="1088" height="870" lineSpacing="6" color="0xEBEBEBFF" visible="false">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </ScrollableText>
        </Group>
        <!-- The title's request asked again while it downloads. -->
        <Timer id="requestPoll" duration="10" />
        <!-- A tab the focus rests on shows its season, and an episode the
             focus rests on fills the info block. -->
        <Timer id="tabRest" duration="0.35" />
        <Timer id="episodeRest" duration="0.4" />
    </children>
</component>
