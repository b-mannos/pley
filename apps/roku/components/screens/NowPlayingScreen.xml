<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing, as on Android TV: the track the music player plays, its
     cover, its artist and album, how far along it is, Shuffle, Previous,
     Pause, Next (with a track after it) and the sleep timer, and under
     them Up next, the queue. Back leaves it; the music goes on, and
     Home's menu brings it back. -->
<component name="NowPlayingScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/NowPlayingScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Music.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="320" loadHeight="320" loadDisplayMode="scaleToZoom" opacity="0.12" />
        <MaskGroup translation="[96, 96]" maskUri="pkg:/images/cover-mask.png" maskSize="[400, 400]">
            <Rectangle id="coverFrame" width="400" height="400" color="0x262B35FF" />
            <Poster id="cover" width="400" height="400" loadWidth="400" loadHeight="400" loadDisplayMode="scaleToZoom" />
        </MaskGroup>
        <!-- The track's lines, each under the one before, so a title of
             one line or two leaves no gap: its title, "Artist · Album",
             and the status line. -->
        <LayoutGroup translation="[560, 104]" layoutDirection="vert" itemSpacings="[12, 20]">
            <Label id="title" width="1264" wrap="true" maxLines="2" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="56" />
            </Label>
            <Label id="byline" width="1264" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="34" />
            </Label>
            <!-- Loading…, why the track doesn't play, or the sleep timer's
                 countdown. -->
            <Label id="message" width="1264" color="0xEB6B70FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
        </LayoutGroup>
        <!-- The scrubber: Up from the buttons, then Left and Right move
             10 s, as on Android TV. -->
        <Poster id="scrubFocus" translation="[540, 436]" width="1304" height="48" uri="pkg:/images/button-footprint.9.png" visible="false" />
        <Group id="scrubber" focusable="true" />
        <Rectangle id="track" translation="[560, 456]" width="1264" height="8" color="0x2E3440FF" />
        <Rectangle id="fill" translation="[560, 456]" width="0" height="8" color="0x38BDF8FF" />
        <Label id="elapsed" translation="[560, 476]" width="300" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
        </Label>
        <Label id="left" translation="[1524, 476]" width="300" horizAlign="right" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
        </Label>
        <ChipRow id="buttons" translation="[96, 560]" />
        <!-- Up next: the queue, the track playing marked, OK playing one. -->
        <Label id="upNextTitle" translation="[96, 652]" text="Up next" color="0xA1A9B6FF" visible="false">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="30" />
        </Label>
        <MarkupList id="upNext" translation="[96, 700]" itemComponentName="QueueRow" itemSize="[1728, 56]" itemSpacing="[0, 8]" numRows="5" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        <!-- How long the remote has rested, looked at each second (a
             quarter of a second while dimmed, so a key wakes it at once). -->
        <Timer id="restTimer" duration="1" repeat="true" />
    </children>
</component>
