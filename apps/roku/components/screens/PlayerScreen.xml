<?xml version="1.0" encoding="utf-8"?>
<!-- The player: the Video node with its own controls, the picture
     subtitles the app draws, the title as each item begins and while
     paused (with the clock and when it ends), Skip Intro and Skip
     Credits, Up Next at an episode's credits (or at its end),
     Pley's menu (Down: Subtitles, Audio, Quality, Subtitle sync,
     Chapters, Previous chapter, Next chapter, Next episode, Sleep timer,
     Find subtitles…, Playback details), the sleep timer's notice,
     Automatic's notice of a lower quality, "Reconnecting…" while the
     server is out of reach, and what went wrong when it did. -->
<component name="PlayerScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- A session stopped from elsewhere, as the event stream tells
             ({ session_id, message, by_admin }). -->
        <field id="serverStopped" type="assocarray" alwaysNotify="true" />
        <!-- A command of the user's remote, on another device, as the
             event stream tells it ({ session_id, command, position_ms,
             offset_ms }). -->
        <field id="playerCommand" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Remote.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/AutoQuality.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Details.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Media.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSearch.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Sleep.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pictures.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080">
            <!-- Picture subtitles (Pictures.brs): the one showing, and the
                 next loading in the other frame. Under the skip button and
                 the player's panels, as captions are. -->
            <Group id="pictures">
                <Poster id="pictureA" opacity="0" loadDisplayMode="scaleToFit" />
                <Poster id="pictureB" opacity="0" loadDisplayMode="scaleToFit" />
            </Group>
            <SkipButton id="skip" translation="[1544, 924]" visible="false" />
        </Video>
        <!-- The title at the top, for 4 s as each item begins and while
             paused or Roku's bar shows; then, at the right, as on Android
             TV, how it plays, the clock and, paused, when it ends. -->
        <Group id="banner" visible="false">
            <Rectangle width="1920" height="200" color="0x000000A6" />
            <Label id="bannerTitle" translation="[96, 56]" width="1144" maxLines="1" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <Label id="bannerLine" translation="[96, 116]" width="1144" maxLines="1" color="0xA1A9B6FF" font="font:SmallSystemFont" />
            <Group id="bannerRight" visible="false">
                <Label id="bannerStatus" translation="[1264, 60]" width="560" horizAlign="right" maxLines="1" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                <Label id="bannerEnds" translation="[1264, 108]" width="560" horizAlign="right" maxLines="1" color="0xA1A9B6FF" font="font:SmallSystemFont" />
            </Group>
        </Group>
        <!-- Waiting for the video, after 500 ms: the spinner in the middle,
             as Android TV's ring, and while the server is out of reach
             "Reconnecting…" 32 px under it, on a backing, as the picture
             behind it can be anything. -->
        <BusySpinner id="spinner" translation="[928, 508]" visible="false" />
        <Group id="reconnecting" visible="false">
            <Rectangle translation="[790, 604]" width="340" height="60" color="0x16191E99" />
            <Label translation="[790, 604]" width="340" height="60" horizAlign="center" vertAlign="center" text="Reconnecting…" color="0xEBEBEBFF" font="font:SmallSystemFont" />
        </Group>
        <!-- Up Next, Android TV's card at the bottom right: the next one's
             still, "Up next · S2 · E6", its title, then Play now and
             Cancel, the countdown beside them (showUpNext sizes and places
             it). -->
        <Group id="upNext" visible="false">
            <Rectangle id="nextBack" width="600" color="0x16191EE6" />
            <Poster id="nextImage" width="600" height="338" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" />
            <Label id="nextHeading" translation="[32, 362]" width="536" maxLines="1" color="0xA1A9B6FF" font="font:SmallerSystemFont" />
            <Label id="nextTitle" translation="[32, 404]" width="536" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <ButtonGroup id="nextButtons" layoutDirection="horiz" itemSpacings="[16]" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="200" maxWidth="200" buttonHeight="64" />
            <Label id="countdown" width="120" height="64" horizAlign="right" vertAlign="center" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        </Group>
        <!-- At the top, clear of the subtitles it moves. -->
        <Group id="sync" translation="[560, 72]" visible="false">
            <Rectangle width="800" height="236" color="0x16191EE6" />
            <Label translation="[48, 40]" text="Subtitle sync" color="0x38BDF8FF" font="font:SmallerBoldSystemFont" />
            <Label id="syncValue" translation="[48, 84]" width="340" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <Label translation="[48, 150]" width="360" wrap="true" maxLines="2" text="Left: earlier · Right: later" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
            <ButtonGroup id="syncButtons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" translation="[440, 48]" minWidth="312" />
        </Group>
        <!-- Pley's menu, at the right over the video: its entries, a
             quality's or a chapter's choices, or the playback's details. -->
        <Group id="menu" visible="false">
            <Rectangle translation="[1240, 0]" width="680" height="1080" color="0x16191EF2" />
            <Label id="menuTitle" translation="[1296, 72]" width="568" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <LabelList id="menuList" translation="[1296, 168]" itemSize="[568, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" font="font:SmallSystemFont" focusedFont="font:SmallBoldSystemFont" />
            <RadioButtonList id="menuChoices" translation="[1296, 168]" itemSize="[568, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" font="font:SmallSystemFont" focusedFont="font:SmallBoldSystemFont" visible="false" />
            <Label id="menuText" translation="[1296, 168]" width="568" wrap="true" maxLines="18" lineSpacing="8" color="0xEBEBEBFF" font="font:SmallerSystemFont" visible="false" />
            <Label id="menuHint" translation="[1296, 940]" width="568" wrap="true" maxLines="3" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        </Group>
        <!-- What went wrong, as Android TV's: centred on black, the title,
             the reason in up to four lines, then Try again (focused)
             beside Back. -->
        <Group id="notice" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000FF" />
            <LayoutGroup translation="[960, 540]" layoutDirection="vert" horizAlignment="center" vertAlignment="center" itemSpacings="[24, 64]">
                <Label id="noticeTitle" width="1280" horizAlign="center" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
                <Label id="noticeText" width="1280" horizAlign="center" wrap="true" maxLines="4" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                <ButtonGroup id="noticeButtons" layoutDirection="horiz" itemSpacings="[24]" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="300" />
            </LayoutGroup>
        </Group>
        <!-- The sleep timer's last 30 s, at the bottom left: Keep watching
             adds the same time again. -->
        <Group id="sleepNotice" translation="[96, 916]" visible="false">
            <Rectangle width="840" height="112" color="0x16191EE6" />
            <Label id="sleepText" translation="[40, 0]" width="420" height="112" vertAlign="center" color="0xEBEBEBFF" font="font:SmallSystemFont" />
            <ButtonGroup id="sleepButtons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" translation="[480, 20]" minWidth="320" />
        </Group>
        <Timer id="countdownTimer" duration="1" repeat="true" />
        <!-- Progress told while paused (Player.brs). -->
        <Timer id="pausedTimer" repeat="true" />
        <!-- The sleep timer's look, once a second while it is set. -->
        <Timer id="sleepTimer" duration="1" repeat="true" />
        <!-- A picture subtitle track not whole yet, asked for again. -->
        <Timer id="picturesTimer" duration="3" />
        <!-- Automatic's look at the playback, once a second while it plays. -->
        <Timer id="autoTimer" duration="1" repeat="true" />
        <!-- The title's banner as an item begins. -->
        <Timer id="bannerTimer" duration="4" />
        <!-- The banner's clock and end time, once a second while they show. -->
        <Timer id="clockTimer" duration="1" repeat="true" />
        <!-- The spinner's wait before it shows. -->
        <Timer id="spinnerTimer" duration="0.5" />
        <!-- A playback stopped from elsewhere says why this long, then
             the player leaves. -->
        <Timer id="stoppedTimer" />
        <!-- The server asked again while it is out of reach. -->
        <Timer id="reconnectTimer" duration="2" />
        <!-- A look once a second at whether the playhead stands still. -->
        <Timer id="stallTimer" duration="1" repeat="true" />
        <!-- Playback details asked again while they show. -->
        <Timer id="detailsTimer" duration="2" repeat="true" />
    </children>
</component>
