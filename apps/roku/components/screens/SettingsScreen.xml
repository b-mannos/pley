<?xml version="1.0" encoding="utf-8"?>
<!-- Settings in two panes, as on Android TV: the categories at the left,
     the focused category's rows at the right (who is signed in above
     Profile's, what signing out does above Sign out's), and the choices of
     a row in a panel over the right half. -->
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/AutoQuality.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Auth.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Profiles.brs" />
    <children>
        <Label translation="[96, 56]" text="Settings" color="0xEBEBEBFF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="56" />
        </Label>
        <MarkupList id="categories" translation="[96, 170]" itemComponentName="SettingRow" itemSize="[348, 72]" itemSpacing="[0, 4]" numRows="8" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <!-- Above Profile's rows: who is signed in, and where. -->
        <Group id="header" translation="[484, 170]" visible="false">
            <!-- The profile's avatar, round as on Android TV. -->
            <MaskGroup maskUri="pkg:/images/round.png" maskSize="[96, 96]">
                <Rectangle id="face" width="96" height="96" color="0x2E3440FF" />
                <Label id="initial" width="96" height="96" horizAlign="center" vertAlign="center" color="0xEBEBEBFF">
                    <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
                </Label>
                <Poster id="picture" width="96" height="96" loadWidth="96" loadHeight="96" loadDisplayMode="scaleToZoom" />
            </MaskGroup>
            <Label id="name" translation="[124, 8]" width="852" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </Label>
            <Label id="who" translation="[124, 56]" width="852" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
        </Group>
        <!-- Above Sign out's row (what it does) and About's (TMDB's notice). -->
        <Label id="intro" translation="[484, 170]" width="976" wrap="true" maxLines="2" color="0xA1A9B6FF" visible="false">
            <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
        </Label>
        <MarkupList id="rows" translation="[460, 300]" itemComponentName="SettingRow" itemSize="[1000, 100]" itemSpacing="[0, 8]" numRows="7" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <!-- The choices of one row, over the right half. -->
        <Group id="panel" visible="false">
            <Rectangle translation="[1000, 0]" width="920" height="1080" color="0x1E222AFF" />
            <Label id="panelTitle" translation="[1056, 56]" width="808" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <RadioButtonList id="choices" translation="[1056, 150]" itemSize="[808, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="34" />
                <Font role="focusedFont" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </RadioButtonList>
            <Label id="panelHint" translation="[1056, 900]" width="808" wrap="true" maxLines="3" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </Label>
        </Group>
    </children>
</component>
