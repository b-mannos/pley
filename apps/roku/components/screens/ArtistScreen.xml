<?xml version="1.0" encoding="utf-8"?>
<!-- An artist, as on Android TV: their picture, round, and beside it
     "Artist", their name, albums, tracks and genres, and their summary;
     under them Play, Shuffle and (while music plays) Now playing side by
     side; then their albums, newest first, as a row of square tiles. The
     text is laid out top to bottom, leaving out what an artist doesn't
     have. -->
<component name="ArtistScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/ArtistScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Music.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" opacity="0.15" />
        <!-- Their initials until the picture comes, or without one. -->
        <MaskGroup translation="[96, 64]" maskUri="pkg:/images/round.png" maskSize="[240, 240]">
            <Rectangle width="240" height="240" color="0x262B35FF" />
            <Label id="initials" width="240" height="240" horizAlign="center" vertAlign="center" color="0xEBEBEBCC" font="font:ExtraLargeBoldSystemFont" />
            <Poster id="picture" width="240" height="240" loadWidth="240" loadHeight="240" loadDisplayMode="scaleToZoom" />
        </MaskGroup>
        <!-- Only the labels with text stay in it (layoutText). -->
        <LayoutGroup id="text" translation="[392, 80]" layoutDirection="vert">
            <Label id="kindLabel" text="Artist" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
            <Label id="name" width="1100" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <Label id="line" width="1100" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
            <Label id="summary" width="1100" wrap="true" maxLines="2" color="0xEBEBEBD9" font="font:SmallestSystemFont" />
        </LayoutGroup>
        <!-- Side by side, Left and Right between them, as Home's hero's. -->
        <ChipRow id="buttons" translation="[96, 344]" pad="80" visible="false" />
        <Label id="albumsLabel" translation="[96, 440]" text="Albums" color="0xEBEBEBFF" font="font:MediumBoldSystemFont" visible="false" />
        <RowList id="albums" translation="[96, 496]" itemComponentName="Tile" itemSize="[1728, 400]" rowItemSize="[[260, 340]]" numRows="1" rowItemSpacing="[[28, 0]]" showRowLabel="[false]" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" />
        <!-- Loading, or what failed with Retry. -->
        <PageMessage id="message" translation="[960, 560]" width="1728" text="Loading…" />
    </children>
</component>
