<?xml version="1.0" encoding="utf-8"?>
<!-- A playlist, over its first entry's backdrop: what it plays, its name
     and what it holds, Play and Shuffle (when it has entries), Rename (but
     for a smart one) and Delete on the left, its entries on the right. OK
     on an entry plays the playlist from it; the Options key on one offers
     Move and Remove from playlist. -->
<component name="PlaylistScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/PlaylistScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/LibraryOrder.brs" />
    <children>
        <!-- The first entry's backdrop, faint. -->
        <Poster id="backdrop" width="1920" height="1080" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" opacity="0.15" />
        <!-- What it plays, its name, what it holds (a smart one's filter
             in words, after its badge) and the buttons, one under the
             other. -->
        <LayoutGroup id="column" translation="[96, 64]" layoutDirection="vert" itemSpacings="[8, 16, 36]">
            <Label id="kindLabel" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
            <Label id="title" width="540" wrap="true" maxLines="2" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <Group id="facts">
                <Group id="smart" visible="false">
                    <Rectangle id="smartBack" height="36" color="0x2E3440FF" />
                    <Label id="smartText" translation="[12, 0]" height="36" vertAlign="center" text="Smart" color="0xEBEBEBFF">
                        <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
                    </Label>
                </Group>
                <Label id="line" width="540" wrap="true" maxLines="3" color="0xA1A9B6FF">
                    <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
                </Label>
            </Group>
            <Buttons id="buttons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="520" maxWidth="540" visible="false" />
        </LayoutGroup>
        <MarkupList id="entries" translation="[700, 64]" itemComponentName="EpisodeRow" itemSize="[1124, 196]" itemSpacing="[0, 16]" numRows="4" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <!-- Loading, or what failed with Retry. -->
        <PageMessage id="message" translation="[1262, 400]" width="1124" text="Loading…" />
        <Label id="hint" translation="[96, 940]" width="540" wrap="true" maxLines="3" color="0xA1A9B6FF" visible="false" text="Up and down move it, OK puts it there, Back puts it back.">
            <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
        </Label>
    </children>
</component>
