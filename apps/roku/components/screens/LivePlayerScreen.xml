<?xml version="1.0" encoding="utf-8"?>
<!-- The live player: a channel's live HLS stream in the Video node (its
     own controls and seek bar off: live is live, with a Live chip), the
     channel's logo with a spinner under it while it tunes, up and down to
     change channel within the category it was opened from, the
     category's channels at the right (OK or the Options key; another
     category, or a search, can be listed there), a bar of what's on and
     next with Channels and the favourite (OK held), and a card of what
     went wrong when it did (every connection in use, the channel not
     playing). -->
<component name="LivePlayerScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The server's live_taken_over: someone took over a channel's
             connection from this account ({ session_id, channel_id, message }). -->
        <field id="liveTakenOver" type="assocarray" alwaysNotify="true" />
        <!-- The watching's session stopped from another device or by the
             server's administrator ({ session_id, message, by_admin }). -->
        <field id="serverStopped" type="assocarray" alwaysNotify="true" />
        <!-- A command of the user's remote, on another device ({
             session_id, command, position_ms, offset_ms }): next and
             previous change channel. -->
        <field id="playerCommand" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/LivePlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Live.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Remote.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="false" />
        <!-- Waiting for data while it plays. -->
        <BusySpinner id="waiting" translation="[928, 508]" visible="false" />
        <!-- The channel while it tunes (the spinner under its logo), and
             over a channel without pictures (radio). -->
        <Group id="card" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000FF" />
            <Rectangle translation="[780, 280]" width="360" height="180" color="0x262B35FF" />
            <Label id="cardInitials" translation="[780, 280]" width="360" height="180" horizAlign="center" vertAlign="center" wrap="true" maxLines="2" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </Label>
            <Poster id="cardLogo" translation="[808, 300]" width="304" height="140" loadWidth="304" loadHeight="140" loadDisplayMode="scaleToFit" />
            <BusySpinner id="tuning" translation="[928, 492]" />
            <!-- Radio: "Sound only" where the spinner was. -->
            <Label id="cardKind" translation="[160, 496]" width="1600" horizAlign="center" color="0xA1A9B6FF" visible="false">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </Label>
            <Label id="cardTitle" translation="[160, 580]" width="1600" horizAlign="center" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <Label id="cardLine" translation="[160, 646]" width="1600" horizAlign="center" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </Label>
        </Group>
        <!-- What's on, with Channels and the favourite, OK held (its star
             shows here too). -->
        <Group id="banner" visible="false">
            <Rectangle translation="[0, 640]" width="1920" height="440" color="0x16191EE6" />
            <Rectangle translation="[96, 712]" width="240" height="120" color="0x2E3440FF" />
            <Label id="bannerInitials" translation="[96, 712]" width="240" height="120" horizAlign="center" vertAlign="center" wrap="true" maxLines="2" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
            </Label>
            <Poster id="bannerLogo" translation="[112, 722]" width="208" height="100" loadWidth="208" loadHeight="100" loadDisplayMode="scaleToFit" />
            <Label id="bannerChannel" translation="[384, 704]" width="1100" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="32" />
            </Label>
            <!-- LIVE or NEW, before the title (placeBadge). -->
            <Label id="bannerBadge" translation="[384, 742]" height="56" vertAlign="center">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
            </Label>
            <Label id="bannerTitle" translation="[384, 742]" width="1100" height="56" vertAlign="center" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <Label id="bannerMeta" translation="[384, 804]" width="1100" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
            <Rectangle id="bannerTrack" translation="[384, 846]" width="1100" height="6" color="0x2E3440FF" />
            <Rectangle id="bannerFill" translation="[384, 846]" width="0" height="6" color="0x38BDF8FF" />
            <Label id="bannerNext" translation="[384, 868]" width="1100" color="0x8B95A5FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
            <!-- The Live chip: live is all there is. -->
            <Rectangle translation="[1648, 710]" width="176" height="52" color="0xEB6B70FF" />
            <Label id="liveMark" translation="[1648, 710]" width="176" height="52" horizAlign="center" vertAlign="center" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="32" />
            </Label>
            <Label id="star" translation="[1648, 776]" width="176" color="0x38BDF8FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
            </Label>
            <!-- Channels, then the favourite; Left and Right between them. -->
            <ChipRow id="controls" translation="[384, 930]" />
        </Group>
        <!-- What went wrong, and what can be done: a card in the middle,
             as Android TV's (trouble places its parts): the channel's
             logo, why, what holds each connection when all are in use
             (Watch here instead on those this account may take), then
             Try again, Other channels and Back to the guide. -->
        <Group id="notice" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000E0" />
            <Group id="noticeCard" translation="[360, 0]">
                <Rectangle id="noticeBack" width="1200" color="0x262B35FF" />
                <Rectangle translation="[480, 64]" width="240" height="136" color="0x2E3440FF" />
                <Label id="noticeInitials" translation="[480, 64]" width="240" height="136" horizAlign="center" vertAlign="center" wrap="true" maxLines="2" color="0xA1A9B6FF">
                    <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="32" />
                </Label>
                <Poster id="noticeLogo" translation="[496, 76]" width="208" height="112" loadWidth="208" loadHeight="112" loadDisplayMode="scaleToFit" />
                <Label id="noticeTitle" translation="[64, 236]" width="1072" wrap="true" maxLines="2" horizAlign="center" color="0xEBEBEBFF">
                    <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
                </Label>
                <Label id="noticeLead" width="1072" horizAlign="center" color="0xA1A9B6FF">
                    <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
                </Label>
                <Group id="noticeRows" />
                <Label id="noticeNote" width="1072" wrap="true" maxLines="2" horizAlign="center" color="0x8B95A5FF">
                    <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
                </Label>
                <Label id="noticeText" width="1072" wrap="true" maxLines="6" horizAlign="center" color="0xA1A9B6FF">
                    <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
                </Label>
                <ChipRow id="noticeChoices" />
            </Group>
        </Group>
        <!-- The category's channels, at the right over the video. -->
        <Group id="list" translation="[1120, 0]" visible="false">
            <Rectangle width="800" height="1080" color="0x16191EF2" />
            <Label id="listTitle" translation="[64, 56]" width="672" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="44" />
            </Label>
            <Label id="listRange" translation="[64, 120]" width="672" color="0x8B95A5FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="26" />
            </Label>
            <MarkupList id="channelList" translation="[40, 176]" itemComponentName="LiveChannelRow" itemSize="[720, 100]" itemSpacing="[0, 4]" numRows="8" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
            <!-- A category, or a search, without channels. -->
            <Label id="listEmpty" translation="[64, 192]" width="672" wrap="true" color="0x8B95A5FF" visible="false">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </Label>
            <!-- Left in the list: another category to list. -->
            <MarkupList id="categoryList" translation="[40, 176]" itemComponentName="LiveRailItem" itemSize="[720, 56]" itemSpacing="[0, 4]" numRows="14" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
            <!-- Two lines: what the channels do, then the categories and search. -->
            <Label id="listHint" translation="[64, 1010]" width="672" wrap="true" maxLines="2" color="0x8B95A5FF">
                <Font role="font" uri="pkg:/fonts/roboto-500.ttf" size="24" />
            </Label>
        </Group>
        <!-- The bar goes after a while left alone; OK still down after
             this is held; up and down wait for more presses before tuning;
             what's on moves on; a channel without pictures is looked for. -->
        <Timer id="bannerTimer" duration="6" />
        <Timer id="okTimer" duration="0.5" />
        <Timer id="zapTimer" duration="0.7" />
        <Timer id="clock" duration="15" repeat="true" />
        <Timer id="pictureTimer" duration="3" />
        <!-- A stall this long shows the spinner. -->
        <Timer id="stallTimer" duration="0.7" />
        <!-- A channel that failed is tuned again after this (1 s, then 3 s). -->
        <Timer id="retryTimer" duration="1" />
    </children>
</component>
