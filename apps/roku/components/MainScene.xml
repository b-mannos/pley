<?xml version="1.0" encoding="utf-8"?>
<!-- The app's one scene: it starts the API task and keeps the stack of
     screens, with the ready-to-watch card over them, and plays what the
     user's remotes cast here; Back on the first screen leaves the app. -->
<component name="MainScene" extends="Scene">
    <interface>
        <!-- Roku's AppLaunchComplete went (uiLaunched). -->
        <field id="launched" type="boolean" />
        <!-- Playbacks so far: Home asks for its rows again after one. -->
        <field id="played" type="integer" />
        <!-- The libraries' order saved so far: Home asks again after one. -->
        <field id="librariesMoved" type="integer" />
        <!-- Changes the server's event stream told of (other devices'): Home
             asks again after one. -->
        <field id="remoteChanges" type="integer" />
        <!-- Of those, the ones about titles (watch state, My List, a
             library's titles, the libraries) and about Live TV's channels:
             the pages showing them ask again, as on Android TV. Both also
             go up when the stream comes back after a gap, since it doesn't
             tell what it missed. -->
        <field id="titleChanges" type="integer" />
        <field id="liveChanges" type="integer" />
        <!-- The latest titles marked watched or unwatched, played, put in
             My List or taken out, or out of Continue Watching
             ([{ count, itemId, action }], Ui.brs's uiNoteChange): the
             screens showing them follow. -->
        <field id="changes" type="array" />
        <field id="changeCount" type="integer" />
        <!-- "Who's watching?" was answered in this launch, on the server in
             use (a profile chosen, a PIN checked, or a sign-in with a
             code): the PIN of the profile signed in isn't asked again.
             Choosing a server starts it over. -->
        <field id="profileChosen" type="boolean" />
        <!-- The ids in My List as Home last saw them, for the Options key. -->
        <field id="myList" type="array" />
        <!-- The Live TV channel watched last in this launch: Live TV opens back
             at it. -->
        <field id="liveChannel" type="integer" />
        <!-- What requests let the profile signed in do (lib/Requests.brs's
             reqSummary; known false until the server said): the menu's
             Discover and requests, and their number. -->
        <field id="requestSummary" type="assocarray" />
        <!-- A title's request changed ({ key, status, libraryId },
             uiNoteRequest): the screens showing its tile give it its
             badge. -->
        <field id="requestNote" type="assocarray" alwaysNotify="true" />
        <!-- A screen did something to a request ({ requestId (0 for
             none), kind, tmdbId }): the summary is asked at once, and
             without the event stream the request's title gets its badge
             where it shows. -->
        <field id="requestTouched" type="assocarray" alwaysNotify="true" />
        <!-- The server's event stream is up: what changes elsewhere is
             told, so pages showing requests need not ask on their own. -->
        <field id="eventsLive" type="boolean" />
        <!-- The server has Live TV for the profile signed in (Home's menu
             has it): the event stream says this Roku takes channels from
             the user's remotes. -->
        <field id="liveTv" type="boolean" />
        <!-- A short message at the top right, gone by itself ({ text,
             error }, Ui.brs's uiToast): what an action did, or why it
             didn't, as the other TVs' toasts say it. -->
        <field id="toast" type="assocarray" alwaysNotify="true" />
        <!-- A language picked on this Roku ("fr"; "" for Automatic): with
             the globe before signing in, or in Settings on a server that
             keeps no account's language. The scene keeps it in the
             registry and shows the language it leads to. -->
        <field id="languageChoice" type="string" alwaysNotify="true" />
        <!-- The server (its address) that answered a choice of the
             account's language 404 or 405: it keeps none, and the
             Language row is this Roku's while it is the one in use, though
             Settings closes. -->
        <field id="languageRefused" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Events.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Remote.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Cast.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Music.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Live.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <children>
        <Group id="screens" />
        <!-- Ready-to-watch news, at the bottom right over the pages. -->
        <RequestNotice id="notice" translation="[1104, 702]" visible="false" />
        <!-- The toast: what an action did, or "Playing from …" as a cast
             starts, over the screen on top (showToast sizes and places
             it). -->
        <Group id="toast" visible="false">
            <Poster id="toastBack" uri="pkg:/images/pill.9.png" blendColor="0x2E3440FF" />
            <Label id="toastText" translation="[40, 22]" color="0xEBEBEBFF">
                <Font role="font" uri="pkg:/fonts/roboto-400.ttf" size="32" />
            </Label>
        </Group>
        <Timer id="toastTimer" duration="3.5" />
        <!-- While the server is out of reach: whether it answers again. -->
        <Timer id="offlinePoll" duration="5" repeat="true" />
        <!-- While a notice waits: whether the remote has rested and the
             page is free for it, four times a second. -->
        <Timer id="noticeWait" duration="0.25" repeat="true" />
        <Timer id="gather" duration="0.3" />
        <!-- Request events, gathered for a second: the summary is asked
             once for those that come together. -->
        <Timer id="requestGather" duration="1" />
        <!-- Without the event stream, the summary each minute. -->
        <Timer id="requestPoll" duration="60" repeat="true" />
    </children>
</component>
